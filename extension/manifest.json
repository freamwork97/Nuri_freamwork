{
  "manifest_version": 3,
  "name": "Nuri",
  "version": "1.0.0",
  "key": "",
  "description": "AI 자동화 브라우저 - Gemini, GPT, Claude 연동 자율 브라우징 에이전트",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3456/*",
    "http://127.0.0.1:3456/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "AI 자동화 사이드패널 열기",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_end"
    }
  ]
}
